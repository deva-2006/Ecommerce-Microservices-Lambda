          [ "AWS/Lambda", "Errors", "FunctionName", "notification-consumer-lambda", { "id": "err7", "label": "notification-consumer-lambda", "stat": "Sum", "region": "us-east-1" } ],
          [ "AWS/Lambda", "Errors", "FunctionName", "order-payment-consumer-lambda", { "id": "err8", "label": "order-payment-consumer-lambda", "stat": "Sum", "region": "us-east-1" } ]
        ],
        "period": 300,
        "region": "us-east-1",
        "title": "Errors (sum)"
