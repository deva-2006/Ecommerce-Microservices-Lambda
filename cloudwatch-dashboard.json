    {
      "type": "text",
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "# DynamoDB - All Tables"
      }
    },
    {
      "type": "metric",
      "width": 12,
      "height": 6,
      "properties": {
        "view": "timeSeries",
        "stacked": true,
        "metrics": [
          [ { "expression": "SEARCH('Namespace=\"AWS/DynamoDB\" MetricName=\"ReadThrottleEvents\"', 'Sum', 300)", "id": "ddb_rte", "region": "us-east-1" } ],
          [ { "expression": "SEARCH('Namespace=\"AWS/DynamoDB\" MetricName=\"WriteThrottleEvents\"', 'Sum', 300)", "id": "ddb_wte", "region": "us-east-1" } ],
          [ { "expression": "SEARCH('Namespace=\"AWS/DynamoDB\" MetricName=\"ThrottledRequests\"', 'Sum', 300)", "id": "ddb_tr", "region": "us-east-1" } ]
        ],
        "period": 300,
        "region": "us-east-1",
        "title": "Throttle Events (sum, all tables)"
      }
    },
    {
      "type": "metric",
      "width": 12,
      "height": 6,
