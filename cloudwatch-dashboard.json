          [ "AWS/Lambda", "Throttles", "FunctionName", "cart-service", { "id": "thr3", "label": "cart-service", "stat": "Sum", "region": "us-east-1" } ],
          [ "AWS/Lambda", "Throttles", "FunctionName", "order-service", { "id": "thr4", "label": "order-service", "stat": "Sum", "region": "us-east-1" } ],
          [ "AWS/Lambda", "Throttles", "FunctionName", "payment-service", { "id": "thr5", "label": "payment-service", "stat": "Sum", "region": "us-east-1" } ],
          [ "AWS/Lambda", "Throttles", "FunctionName", "review-service", { "id": "thr6", "label": "review-service", "stat": "Sum", "region": "us-east-1" } ],
