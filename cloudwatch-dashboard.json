          [ "AWS/Lambda", "Duration", "FunctionName", "inventory-service", { "id": "dur2", "label": "inventory-service", "stat": "Average", "region": "us-east-1" } ],
          [ "AWS/Lambda", "Duration", "FunctionName", "cart-service", { "id": "dur3", "label": "cart-service", "stat": "Average", "region": "us-east-1" } ],
