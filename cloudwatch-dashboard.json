{
  "widgets": [
    {
      "type": "text",
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "# API Gateway - Microservice API (Default Stage)"
      }
    },
    {
      "type": "metric",
      "width": 8,
      "height": 6,
      "properties": {
        "view": "timeSeries",
        "stacked": false,
        "metrics": [
          [ "AWS/ApiGateway", "Latency", "ApiId", "73svzbgcrf", "Stage", "$default", { "id": "lat_avg", "label": "Latency (avg)", "stat": "Average", "region": "us-east-1" } ],
          [ "AWS/ApiGateway", "Latency", "ApiId", "73svzbgcrf", "Stage", "$default", { "id": "lat_p90", "label": "Latency (p90)", "stat": "p90", "region": "us-east-1" } ],
          [ "AWS/ApiGateway", "Latency", "ApiId", "73svzbgcrf", "Stage", "$default", { "id": "lat_p99", "label": "Latency (p99)", "stat": "p99", "region": "us-east-1" } ]
        ],
        "period": 300,
        "region": "us-east-1",
        "title": "Latency (ms)",
        "yAxis": { "left": { "label": "ms" } }
      }
    },
    {
      "type": "metric",
      "width": 8,
      "height": 6,
      "properties": {
        "view": "timeSeries",
        "stacked": true,
        "metrics": [
          [ "AWS/ApiGateway", "4xx", "ApiId", "73svzbgcrf", "Stage", "$default", { "id": "e_4xx", "label": "4xx Errors", "stat": "Sum", "region": "us-east-1" } ]
        ],
        "period": 300,
        "region": "us-east-1",
        "title": "4XX Errors (sum)"
      }
    },
    {
      "type": "metric",
      "width": 8,
      "height": 6,
      "properties": {
        "view": "timeSeries",
        "stacked": true,
        "metrics": [
          [ "AWS/ApiGateway", "5xx", "ApiId", "73svzbgcrf", "Stage", "$default", { "id": "e_5xx", "label": "5xx Errors", "stat": "Sum", "region": "us-east-1" } ]
        ],
        "period": 300,
        "region": "us-east-1",
        "title": "5XX Errors (sum)"
      }
    },
    {
      "type": "text",
      "width": 24,
      "height": 1,
