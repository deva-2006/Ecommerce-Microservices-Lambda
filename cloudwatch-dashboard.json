          [ { "expression": "SEARCH('Namespace=\"AWS/DynamoDB\" MetricName=\"SystemErrors\"', 'Sum', 300)", "id": "ddb_se", "region": "us-east-1" } ],
          [ { "expression": "SEARCH('Namespace=\"AWS/DynamoDB\" MetricName=\"UserErrors\"', 'Sum', 300)", "id": "ddb_ue", "region": "us-east-1" } ],
          [ { "expression": "SEARCH('Namespace=\"AWS/DynamoDB\" MetricName=\"ConditionalCheckFailedRequests\"', 'Sum', 300)", "id": "ddb_ccf", "region": "us-east-1" } ]
