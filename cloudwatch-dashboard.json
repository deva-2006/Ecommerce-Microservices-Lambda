          [ "AWS/Lambda", "Duration", "FunctionName", "inventory-service", { "id": "p99_2", "label": "inventory-service", "stat": "p99", "region": "us-east-1" } ],
          [ "AWS/Lambda", "Duration", "FunctionName", "cart-service", { "id": "p99_3", "label": "cart-service", "stat": "p99", "region": "us-east-1" } ],
          [ "AWS/Lambda", "Duration", "FunctionName", "order-service", { "id": "p99_4", "label": "order-service", "stat": "p99", "region": "us-east-1" } ],
          [ "AWS/Lambda", "Duration", "FunctionName", "payment-service", { "id": "p99_5", "label": "payment-service", "stat": "p99", "region": "us-east-1" } ],
