      "height": 6,
      "properties": {
        "view": "timeSeries",
        "stacked": true,
        "metrics": [
          [ "AWS/CloudFront", "BytesDownloaded", "DistributionId", "E1UOOQSQUW4GDB", "Region", "Global", { "id": "cf_bytes", "label": "Bytes Downloaded", "stat": "Sum", "region": "us-east-1" } ]
