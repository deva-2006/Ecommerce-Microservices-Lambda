        "metrics": [
          [ "AWS/CloudFront", "4xxErrorRate", "DistributionId", "E1UOOQSQUW4GDB", "Region", "Global", { "id": "cf_4xx", "label": "4xx Error Rate", "stat": "Average", "region": "us-east-1" } ],
          [ "AWS/CloudFront", "5xxErrorRate", "DistributionId", "E1UOOQSQUW4GDB", "Region", "Global", { "id": "cf_5xx", "label": "5xx Error Rate", "stat": "Average", "region": "us-east-1" } ],
